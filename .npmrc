# Отключаем превращение pnpm в npm (сохраняем строгую изоляцию)
shamefully-hoist=false

# Предотвращаем падение pnpm install из-за нестрогих peer-версий в сторонних пакетах
strict-peer-dependencies=false

# Автоматически доустанавливаем недостающие peer-зависимости, если их просит модуль
auto-install-peers=true

# Поднимаем типы TypeScript в корень, чтобы IDE корректно видела их во всем монорепо
public-hoist-pattern[]=*types*

# Автоматически связываем пакеты из apps/ и shared/ через workspace:*
link-workspace-packages=true

# Прерывать pnpm install, если версия Node.js не соответствует полю engines
engine-strict=true
