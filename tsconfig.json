{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"],

    /* Настройки для связывания монорепозитория */
    "baseUrl": ".",
    "paths": {
      // "@my-app/shared-utils": ["shared/utils/src/index.ts"],
      // "@my-app/infra-database": ["infra/database/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
